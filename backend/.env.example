# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:4200

# University SQL Server (the dashboard only runs SELECT queries)
DB_HOST=your_sql_server_host
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ENCRYPT=false

# Second SQL Server (PU_2026): course-wise nominal rolls, marks and results
DB2_HOST=your_second_sql_server_host
DB2_PORT=1433
DB2_NAME=PU_2026
DB2_USER=your_db_user
DB2_PASSWORD=your_db_password
DB2_ENCRYPT=false

# Seconds to reuse dashboard aggregates before querying again
DASHBOARD_CACHE_SECONDS=1800

# Dashboard logins: add accounts with `npm run add-user -- someone@example.com`
# (stores "email:scrypt-hash" entries here). AUTH_SECRET signs login tokens.
AUTH_USERS=
AUTH_SECRET=
AUTH_TOKEN_HOURS=8
